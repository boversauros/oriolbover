{
  "name": "oriolbover",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "update-data": "node  --env-file=.env scripts/update-data.js",
    "update-data:ci": "node scripts/update-data.js",
    "predeploy": "pnpm update-data && pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "keywords": [
    "portfolio",
    "website",
    "development"
  ],
  "author": "",
  "license": "ISC",
  "description": "Oriol Bover's portfolio website",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.5.7",
    "prettier": "3.9.10"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24.22.1"
  }
}
